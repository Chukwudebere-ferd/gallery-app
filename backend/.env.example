# Aiven PostgreSQL
DATABASE_URL=postgres://avnadmin:PASSWORD@svgcamp2026-schoenstattapk-camp.a.aivencloud.com:26894/defaultdb?sslmode=require

# Firebase Admin SDK service account JSON key
# Download it from Firebase Console -> Project settings -> Service accounts
# and save it as firebase-admin.json in this folder (already gitignored)
FIREBASE_CREDENTIALS_PATH=firebase-admin.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Email (sendlib)
SENDLIB_API_URL=https://sendlib.samueltuoyo.com/
SENDLIB_API_KEY=your-sendlib-api-key

# Object storage (byteship)
BYTESHIP_API_KEY=your-byteship-api-key
BYTESHIP_ENDPOINT=https://api.byteship.dev

# Image hosting (imgbb)
IMGBB_API_KEY=your-imgbb-api-key

# CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000